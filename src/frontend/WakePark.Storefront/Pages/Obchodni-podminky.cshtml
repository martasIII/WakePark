@page
@{
    ViewData["Title"] = T["TermsTitle"].Value;
    ViewData["Description"] = T["TermsDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["TermsHeading"].Value;
}
<partial name="_PageHeader" />
<main class="page-body">
    @if (SiteView.Language != "cs")
    {
        <section class="card">
            <p>@T["TermsCzechOnly"] <a href="mailto:info@("@")wake-dzban.cz">info@("@")wake-dzban.cz</a>.</p>
        </section>
    }
    <partial name="_ObchodniPodminkyCs" />
</main>
