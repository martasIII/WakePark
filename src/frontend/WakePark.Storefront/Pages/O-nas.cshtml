@page
@{
    ViewData["Title"] = T["AboutTitle"].Value;
    ViewData["Description"] = T["AboutDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["AboutHeading"].Value;
    ViewData["Subtitle"] = T["Location"].Value;
}
@* Texty od Dana (11/2026). *@
<partial name="_PageHeader" />
<main class="page-body">
    @* Smyčka z videa ze starého webu (2024), 16:9 bez zvuku — rámeček jako dlaždice na úvodu, široký jako karty pod ním. *@
    <div class="video-frame">
        <video autoplay muted loop playsinline preload="metadata" poster="~/img/hp/onas-video.jpg" aria-hidden="true">
            <source src="~/img/hp/onas-video.mp4" type="video/mp4">
        </video>
    </div>
    <section class="card">
        <h2>Wake Park Džbán</h2>
        <p>@T["AboutIntro"]</p>
    </section>
    <section class="card">
        <h2>@T["AboutCable1Title"]</h2>
        <p>@T["AboutCable1Text"]</p>
    </section>
    <section class="card">
        <h2>@T["AboutCable2Title"]</h2>
        <p>@T["AboutCable2Text"]</p>
    </section>
    <section class="card">
        <h2>@T["AboutFacilitiesTitle"]</h2>
        <p>@T["AboutFacilitiesText"]</p>
    </section>
    <partial name="_Galerie" model="@(new[] { "vleky", "vlek1-1", "vlek2-1", "foil", "rainbow1", "sunset1", "sunset2", "sunset3", "sunset4", "david-skate", "veru-skate", "ondra-pes" })" />
</main>
