@page
@{
    ViewData["Title"] = T["WakeBarTitle"].Value;
    ViewData["Description"] = T["WakeBarDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["WakeBarHeading"].Value;
    ViewData["Subtitle"] = T["Location"].Value;
}
@* Texty od Dana (11/2026). *@
<partial name="_PageHeader" />
<main class="page-body">
    @* Hotdog na výrazném místě (přání Dana): velká fotka přímo u textu. *@
    <section class="card feature">
        <img src="~/img/foto/hotdog.webp" alt="@T["WakeBarHotDogAlt"]" width="1080" height="1080">
        <p>@T["WakeBarText"]</p>
    </section>
    <partial name="_Galerie" model="@(new[] { "hotdog", "wakebar-cep", "wakebar-tabule", "wakebar-fronta", "teras", "terasa2", "sekt", "party2", "jatro1", "jatro2" })" />
</main>
