@page
@{
    ViewData["Title"] = T["WakeBarTitle"].Value;
    ViewData["Description"] = T["WakeBarDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["WakeBarHeading"].Value;
    ViewData["Subtitle"] = T["Location"].Value;
}
@* Texty od Dana (11/2026). *@
<partial name="_PageHeader" />
<main class="page-body">
    @* Velká fotka přímo u textu: barmanka u pípy. *@
    <section class="card feature">
        <img src="~/img/foto/wakebar-cep.webp" alt="@T["WakeBarFeatureAlt"]" width="1080" height="1080">
        <p>@T["WakeBarText"]</p>
    </section>
    <partial name="_Galerie" model="@(new[] { "wakebar-cep", "hotdog", "wakebar-tabule", "wakebar-fronta", "teras", "terasa2", "sekt", "party2", "jatro1", "jatro2" })" />
</main>
