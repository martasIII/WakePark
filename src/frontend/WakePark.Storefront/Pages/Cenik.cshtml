@page
@model CenikModel
@using WakePark.Storefront.Eshop
@{
    ViewData["Title"] = T["PricesTitle"].Value;
    ViewData["Description"] = T["PricesDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["Prices"].Value;
    ViewData["Subtitle"] = Model.PriceList?.Title?.Resolve(SiteView.Language);
    string lang = SiteView.Language;
}
<partial name="_PageHeader" />
<main class="page-body">
    @if (Model.PriceList is null)
    {
        <section class="card"><p>@T["LoadFailed"] <a href="tel:+420737562516">+420 737 562 516</a>.</p></section>
    }
    else
    {
        foreach (WebPriceSection group in Model.PriceList.Sections)
        {
            <section class="card" id="@group.Code">
                <h2>@group.Name.Resolve(lang)</h2>
                @{ RenderGroup(group, lang); }
                @foreach (WebPriceSection subsection in group.Subsections)
                {
                    <h3 class="subsection" id="@subsection.Code">@subsection.Name.Resolve(lang)</h3>
                    RenderGroup(subsection, lang);
                }
            </section>
        }
    }
</main>

@functions {
    // Popis a položky sekce i podsekce vypadají stejně.
    private void RenderGroup(WebPriceSection section, string lang)
    {
        if (section.Description is not null)
        {
            <p class="note">@SiteView.Linkify(section.Description.Resolve(lang))</p>
        }

        foreach (WebPriceItem item in section.Items)
        {
            <div class="row">
                <div class="name">
                    <b>@item.Name.Resolve(lang)</b>
                    @if (item.Badge is not null)
                    {
                        <span class="tag">@item.Badge.Resolve(lang)</span>
                    }
                    @if (item.Description is not null)
                    {
                        <span class="desc">@item.Description.Resolve(lang)</span>
                    }
                </div>
                @if (item.UnitPrice == 0)
                {
                    <div class="price free">@T["Free"]</div>
                }
                else
                {
                    <div class="price">@SiteView.Price(item.UnitPrice)</div>
                }
            </div>
        }
    }
}
