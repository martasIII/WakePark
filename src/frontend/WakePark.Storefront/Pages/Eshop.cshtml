@page
@model EshopModel
@using WakePark.Storefront.Eshop
@{
    ViewData["Title"] = "E-shop — Wake Park Džbán";
    ViewData["Description"] = T["EshopDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = "E-shop";
    ViewData["Subtitle"] = T["EshopSubtitle"].Value;
    string lang = SiteView.Language;
}
<partial name="_PageHeader" />
<main class="page-body">
    <partial name="_TrialBanner" />
    @if (Model.Catalog is null || Model.Catalog.Products.Count == 0)
    {
        <section class="card"><p>@T["LoadFailed"] <a href="tel:+420737562516">+420 737 562 516</a>.</p></section>
    }
    else
    {
        <form method="post" class="order-form" novalidate>
            @if (Model.Errors.Count > 0)
            {
                <section class="card errors" role="alert">
                    <h2>@T["OrderErrors"]</h2>
                    <ul>
                        @foreach (string error in Model.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </section>
            }

            @foreach (EshopCategory category in Model.Catalog.Categories)
            {
                <section class="card" id="@category.Code">
                    <h2>@category.Name.Resolve(lang)</h2>
                    <ul class="products">
                        @foreach (EshopProduct product in Model.ProductsIn(category))
                        {
                            string inputId = $"q-{product.Code}";
                            <li class="product" id="@product.Code">
                                @if (product.ImagePath is not null)
                                {
                                    <img src="@product.ImagePath" alt="" width="400" height="250" loading="lazy">
                                }
                                <h3>@product.Name.Resolve(lang)</h3>
                                <p class="desc">@product.Description.Resolve(lang)</p>
                                <p class="price">@SiteView.Price(product.UnitPrice) <span>@T["InclVat"]</span></p>
                                <label class="qty" for="@inputId">@T["Quantity"]
                                    <span class="stepper">
                                        <input id="@inputId" type="number" name="Quantities[@product.Id]"
                                               value="@Model.QuantityOf(product)" min="0" max="20" inputmode="numeric"
                                               data-price="@product.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                               data-less="@T["Less"]" data-more="@T["More"]">
                                    </span>
                                </label>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="card contact">
                <h2>@T["Contact"]</h2>
                <div class="fields">
                    <label>@T["Name"] <input asp-for="Form.Name" autocomplete="name" required></label>
                    <label>@T["Email"] <input asp-for="Form.Email" type="email" autocomplete="email" required></label>
                    <label>@T["Phone"] <span class="opt">@T["Optional"]</span> <input asp-for="Form.Phone" type="tel" autocomplete="tel"></label>
                </div>
                <details class="company" open="@(Model.Form.CompanyName is not null || Model.Form.CompanyId is not null ? "open" : null)">
                    <summary>@T["BuyingAsCompany"]</summary>
                    <div class="fields">
                        <label>@T["CompanyName"] <input asp-for="Form.CompanyName" autocomplete="organization"></label>
                        <label>@T["CompanyId"] <input asp-for="Form.CompanyId" inputmode="numeric"></label>
                        <label>@T["VatId"] <input asp-for="Form.VatId"></label>
                    </div>
                </details>
                @* Past na roboty — člověk pole nevidí ani do něj nedojde tabulátorem. *@
                <div class="hp" aria-hidden="true">
                    <label>Web <input asp-for="Form.Website" tabindex="-1" autocomplete="off"></label>
                </div>
                <label class="terms">
                    <input asp-for="Form.TermsAccepted">
                    <span>@T["TermsAgree"] <a asp-page="/Obchodni-podminky" asp-route-lang="@Site.LanguageRoute" target="_blank">@T["Terms"]</a>.</span>
                </label>
                <p class="pay-note">@T["PayNote"]</p>
                <p class="order-total" hidden>@T["Total"] <b data-amount></b></p>
                <button type="submit" class="order-button">@T["PlaceOrder"]</button>
            </section>
        </form>
        <script src="~/js/eshop.js" asp-append-version="true" defer></script>
    }
</main>
