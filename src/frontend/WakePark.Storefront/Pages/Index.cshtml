@page
@{
    ViewData["Title"] = T["HomeTitle"].Value;
    ViewData["Description"] = T["HomeDescription"].Value;
    ViewData["BodyClass"] = "home";
    string reservation = Site.Options.ReservationUrl.ToString();
}
<main>
    <h1 class="sr-only">Wake Park Džbán</h1>
    @* Dlaždice 4 × 2 podle náčrtku. Wake Bar, Minirampa a Džbán Park zatím nemají stránku. *@
    <ul class="tiles">
        <li><a class="tile" asp-page="/Cenik" asp-route-lang="@Site.LanguageRoute" aria-label="@T["TileWakeDzban"]"><partial name="Icons/_WakeDzban" /></a></li>
        <li><a class="tile" href="@reservation" aria-label="@T["TileCable1"]"><partial name="Icons/_Vlek1" /></a></li>
        <li><a class="tile" href="@reservation" aria-label="@T["TileCable2"]"><partial name="Icons/_Vlek2" /></a></li>
        <li><div class="tile soon" role="img" aria-label="Wake Bar — @T["ComingSoonLower"]" title="@T["ComingSoon"]"><partial name="Icons/_WakeBar" /></div></li>
        <li><div class="tile soon" role="img" aria-label="@T["TileMiniRamp"] — @T["ComingSoonLower"]" title="@T["ComingSoon"]"><partial name="Icons/_Minirampa" /></div></li>
        <li><a class="tile" asp-page="/Kontakt" asp-route-lang="@Site.LanguageRoute" aria-label="@T["Contact"]"><partial name="Icons/_Kontakt" /></a></li>
        <li><a class="tile" asp-page="/Eshop" asp-route-lang="@Site.LanguageRoute" aria-label="@T["TileShop"]"><partial name="Icons/_WakeShop" /></a></li>
        <li><div class="tile soon" role="img" aria-label="Džbán Park — @T["ComingSoonLower"]" title="@T["ComingSoon"]"><partial name="Icons/_DzbanPark" /></div></li>
    </ul>
</main>
