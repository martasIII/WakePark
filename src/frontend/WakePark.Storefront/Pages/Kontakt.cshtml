@page
@model KontaktModel
@{
    ViewData["Title"] = T["ContactTitle"].Value;
    ViewData["Description"] = T["ContactDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["Contact"].Value;
    ViewData["Subtitle"] = T["Location"].Value;
}
<partial name="_PageHeader" />
<main class="page-body">

  <section class="card">
    <h2>@T["WhereToFind"]</h2>
    <div class="kv-grid">
      <p class="kv"><b>@T["Address"]</b><span>@T["AddressLine1"]<br>@T["AddressLine2"]</span></p>
      <p class="kv"><b>GPS</b><a href="https://mapy.com/en/zakladni?q=50.09538983277756%2C14.334289900588386&amp;source=firm&amp;id=13652879&amp;x=14.3335473&amp;y=50.0946580&amp;z=18.248">50.0954, 14.3343</a></p>
      <p class="kv"><b>@T["Phone"]</b><a href="tel:+420737562516">+420 737 562 516</a></p>
      <p class="kv"><b>E-mail</b><a href="mailto:info@@wake-dzban.cz">info@@wake-dzban.cz</a></p>
    </div>
    <a class="btn" href="https://mapy.com/en/zakladni?q=50.09538983277756%2C14.334289900588386&amp;source=firm&amp;id=13652879&amp;x=14.3335473&amp;y=50.0946580&amp;z=18.248">@T["OpenInMaps"]</a>
  </section>

  <section class="card" id="doba">
    <h2>@T["OpeningHours"]</h2>
    @if (Model.Hours is null)
    {
        <p class="note">@T["LoadFailed"] <a href="tel:+420737562516">+420 737 562 516</a>.</p>
    }
    else
    {
        <table class="hours">
            @foreach (OpeningHoursView.DayRow day in Model.Hours.Days)
            {
                <tr class="@(day.IsToday ? "today" : null)">
                    <td>@day.Day @if (day.IsToday) { <span class="tag">@T["Today"]</span> }</td>
                    <td>@day.Hours
                        @foreach (string blocking in day.Blockings ?? [])
                        {
                            <span class="desc">@blocking</span>
                        }
                    </td>
                </tr>
            }
        </table>
        @if (Model.Hours.Exceptions.Count > 0)
        {
            <h3>@T["Exceptions"]</h3>
            <table class="hours">
                @foreach (OpeningHoursView.ExceptionRow exception in Model.Hours.Exceptions)
                {
                    <tr>
                        <td>@exception.Date @if (exception.Note is not null) { <span class="desc-inline">@exception.Note</span> }</td>
                        <td>@exception.Hours</td>
                    </tr>
                }
            </table>
        }
        @if (Model.Hours.Note is not null)
        {
            <p class="note">@Model.Hours.Note</p>
        }
    }
    <a class="btn" href="@Site.Options.ReservationUrl">@T["BookingSystem"]</a>
  </section>

  <section class="card">
    <h2>@T["ContactPeople"]</h2>
    <div class="row"><div class="name"><b>Dan Beitl</b>
      <span class="desc">@T["RoleDan"]</span>
      <span class="desc"><a href="mailto:dan@@wake-dzban.cz">dan@@wake-dzban.cz</a></span></div></div>
    <div class="row"><div class="name"><b>Kateřina Korejsová</b>
      <span class="desc">@T["RoleKaterina"]</span>
      <span class="desc"><a href="mailto:info@@wake-dzban.cz">info@@wake-dzban.cz</a> · <a href="tel:+420737562516">+420 737 562 516</a></span></div></div>
  </section>

  <section class="card">
    <h2>@T["HowToGetHere"]</h2>
    <p class="note">@T["HowToGetHereNote"]</p>
    <div class="row"><div class="name"><b>@T["ByTram"]</b>
      <span class="desc">@T["ByTramText"]</span></div></div>
    <div class="row"><div class="name"><b>@T["ByMetro"]</b>
      <span class="desc">@T["ByMetroText"]</span></div></div>
    <div class="row"><div class="name"><b>@T["ByCar"]</b>
      <span class="desc">@T["ByCarText"]</span></div></div>
  </section>

  <section class="card">
    <h2>@T["Operator"]</h2>
    <div class="kv-grid">
      <p class="kv"><b>@T["ParkOperator"]</b><span>WAKEMASTER s.r.o., @T["CompanyIdShort"] 02819082</span></p>
      <p class="kv"><b>@T["ParkManager"]</b><span>Wake Park s.r.o., @T["CompanyIdShort"] 06633633</span></p>
    </div>
  </section>

</main>
