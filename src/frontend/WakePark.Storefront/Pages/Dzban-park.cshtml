@page
@{
    ViewData["Title"] = T["DzbanParkTitle"].Value;
    ViewData["Description"] = T["DzbanParkDescription"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["DzbanParkHeading"].Value;
    ViewData["Subtitle"] = T["Location"].Value;
}
@* Texty od Dana (11/2026). Odkaz na provozní řád doplníme, až bude PDF. *@
<partial name="_PageHeader" />
<main class="page-body">
    <section class="card">
        <p>@T["DzbanParkText1"]</p>
        <p>@T["DzbanParkText2"]</p>
    </section>
    <partial name="_Galerie" model="@(new[] { "dzban-park1", "dzban-park2", "dzban-park3", "joga1", "joga2", "workout", "kad1", "kad2", "lecamile", "podzim" })" />
</main>
