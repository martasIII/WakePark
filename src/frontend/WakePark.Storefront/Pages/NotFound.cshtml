@page
@{
    ViewData["Title"] = T["NotFoundTitle"].Value;
    ViewData["BodyClass"] = "page";
    ViewData["Heading"] = T["NotFoundHeading"].Value;
    ViewData["Subtitle"] = T["NotFoundSubtitle"].Value;
}
<partial name="_PageHeader" />
<main class="page-body">
    <section class="card">
        <p>@T["NotFoundTry"] <a asp-page="/Index" asp-route-lang="@Site.LanguageRoute">@T["HomePage"]</a>,
            <a asp-page="/Cenik" asp-route-lang="@Site.LanguageRoute">@T["PricesLower"]</a> @T["Or"]
            <a asp-page="/Kontakt" asp-route-lang="@Site.LanguageRoute">@T["ContactLower"]</a>.</p>
    </section>
</main>
